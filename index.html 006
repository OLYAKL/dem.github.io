/* style.css — современный стиль для вашего блога */

/* 🌐 Подключение шрифтов и сброс стилей */
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');

*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

:root {
  /* 🎨 Цветовая палитра (тёмная тема по умолчанию) */
  --bg-primary: #0f172a;
  --bg-secondary: #1e293b;
  --bg-card: #334155;
  --text-primary: #f1f5f9;
  --text-secondary: #94a3b8;
  --accent: #818cf8;
  --accent-hover: #6366f1;
  --border: #475569;
  --success: #22c55e;
  --warning: #f59e0b;
  
  /* 📐 Отступы и радиусы */
  --radius: 12px;
  --radius-lg: 20px;
  --spacing-sm: 0.5rem;
  --spacing-md: 1rem;
  --spacing-lg: 1.5rem;
  --spacing-xl: 2rem;
  
  /* ✨ Тени и переходы */
  --shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
  --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
  --transition: all 0.2s ease;
}

/* 🌞 Светлая тема (автоматически при prefers-color-scheme) */
@media (prefers-color-scheme: light) {
  :root {
    --bg-primary: #f8fafc;
    --bg-secondary: #ffffff;
    --bg-card: #f1f5f9;
    --text-primary: #0f172a;
    --text-secondary: #64748b;
    --border: #e2e8f0;
    --shadow: 0 4px 6px -1px rgb(0 0 0 / 0.05);
  }
}

/* 📦 Базовые стили */
body {
  font-family: 'Inter', system-ui, -apple-system, sans-serif;
  background: var(--bg-primary);
  color: var(--text-primary);
  line-height: 1.6;
  padding: var(--spacing-lg);
  max-width: 800px;
  margin: 0 auto;
  transition: var(--transition);
}

/* 🔗 Ссылки */
a {
  color: var(--accent);
  text-decoration: none;
  font-weight: 500;
  transition: var(--transition);
  position: relative;
}

a:hover {
  color: var(--accent-hover);
}

a::after {
  content: '';
  position: absolute;
  bottom: -2px;
  left: 0;
  width: 0;
  height: 2px;
  background: var(--accent);
  transition: var(--transition);
}

a:hover::after {
  width: 100%;
}

/* 📰 Заголовки */
h2 {
  font-size: 1.5rem;
  font-weight: 700;
  margin: var(--spacing-xl) 0 var(--spacing-md);
  padding-bottom: var(--spacing-sm);
  border-bottom: 2px solid var(--border);
  color: var(--text-primary);
}

h2:first-child {
  margin-top: 0;
}

/* 📝 Параграфы и текст */
p, blockquote {
  margin: var(--spacing-md) 0;
  color: var(--text-secondary);
}

/* 💬 Цитаты */
blockquote {
  border-left: 4px solid var(--accent);
  padding: var(--spacing-md) var(--spacing-lg);
  background: var(--bg-secondary);
  border-radius: 0 var(--radius) var(--radius) 0;
  font-style: italic;
  color: var(--text-primary);
}

blockquote.q {
  background: linear-gradient(135deg, var(--bg-secondary), var(--bg-card));
}

/* 🗂️ Карточки для постов */
body > h2 {
  position: relative;
  padding-left: var(--spacing-lg);
}

body > h2::before {
  content: '📌';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  font-size: 1.2rem;
}

/* 🧩 Код и технические блоки */
p:has(code), p:contains("DataFrame"), p:contains("prediction") {
  background: var(--bg-secondary);
  padding: var(--spacing-md);
  border-radius: var(--radius);
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.9rem;
  overflow-x: auto;
  border: 1px solid var(--border);
}

/* 🔐 Крипто-блоки (стилизация под терминал) */
p:contains("Шифртекст"), p:contains("Открытый ключ"), p:contains("Числовое представление") {
  background: #0a0a0f;
  color: #22c55e;
  padding: var(--spacing-md);
  border-radius: var(--radius);
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.85rem;
  border: 1px solid #1e293b;
  margin: var(--spacing-md) 0;
}

/* 🖼️ Изображения */
img {
  max-width: 100%;
  height: auto;
  border-radius: var(--radius-lg);
  display: block;
  margin: var(--spacing-lg) auto;
  box-shadow: var(--shadow-lg);
  transition: var(--transition);
}

img:hover {
  transform: scale(1.02);
}

/* 📋 Списки и элементы */
ul, ol {
  margin: var(--spacing-md) 0;
  padding-left: var(--spacing-xl);
}

li {
  margin: var(--spacing-sm) 0;
  color: var(--text-secondary);
}

/* 🎯 Кнопки и интерактив */
a[href^="mailto"] {
  display: inline-flex;
  align-items: center;
  gap: var(--spacing-sm);
  background: var(--accent);
  color: white;
  padding: var(--spacing-sm) var(--spacing-lg);
  border-radius: 50px;
  font-weight: 600;
  box-shadow: var(--shadow);
}

a[href^="mailto"]:hover {
  background: var(--accent-hover);
  transform: translateY(-2px);
  box-shadow: var(--shadow-lg);
  color: white;
}

a[href^="mailto"]::after {
  display: none;
}

/* 📁 Ссылки на файлы */
a[href$=".png"], a[href$=".xlsx"], a[href$=".ods"], a[href$=".html"] {
  display: inline-flex;
  align-items: center;
  gap: var(--spacing-sm);
  padding: var(--spacing-sm) var(--spacing-md);
  background: var(--bg-secondary);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  font-size: 0.95rem;
}

a[href$=".png"]:hover,
a[href$=".xlsx"]:hover,
a[href$=".ods"]:hover {
  background: var(--bg-card);
  border-color: var(--accent);
}

/* 📱 Адаптивность */
@media (max-width: 600px) {
  body {
    padding: var(--spacing-md);
    font-size: 0.95rem;
  }
  
  h2 {
    font-size: 1.3rem;
  }
  
  blockquote {
    padding: var(--spacing-sm) var(--spacing-md);
  }
}

/* ✨ Анимация появления */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

body > * {
  animation: fadeIn 0.3s ease forwards;
  animation-delay: calc(var(--i, 0) * 0.05s);
}

/* 🎨 Переключатель темы (опционально) */
.theme-toggle {
  position: fixed;
  top: var(--spacing-md);
  right: var(--spacing-md);
  background: var(--bg-secondary);
  border: 1px solid var(--border);
  border-radius: 50%;
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  font-size: 1.2rem;
  transition: var(--transition);
  z-index: 100;
}

.theme-toggle:hover {
  background: var(--accent);
  color: white;
  transform: rotate(15deg);
}

/* 🪄 Микровзаимодействия */
@media (prefers-reduced-motion: no-preference) {
  a, img, .theme-toggle {
    will-change: transform;
  }
}
